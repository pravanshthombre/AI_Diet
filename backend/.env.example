# Supabase / PostgreSQL Connection String
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase JWT Secret
# Get this from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
# When set, the API verifies JWT tokens. When empty, runs in development mode.
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# CORS Origins (comma-separated, use * for development)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
